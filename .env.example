DATABASE_URL=postgresql+psycopg://roomscout_app:roomscout_local_app@localhost:55432/roomscout
CHECKPOINT_URL=postgresql://roomscout_app:roomscout_local_app@localhost:55432/roomscout?options=-csearch_path%3Dcheckpoints
DEMO_TOKEN=roomscout-local-demo
MEMORY_DEBOUNCE_SECONDS=30
POLL_INTERVAL=0.5

# Fill your provider's API root (usually ends in /v1), NOT /chat/completions.
ROOMSCOUT_LLM_BASE_URL=
ROOMSCOUT_LLM_API_KEY=
ROOMSCOUT_LLM_MODEL=
ROOMSCOUT_LLM_TIMEOUT_SECONDS=60
ROOMSCOUT_LLM_MAX_TOKENS=1500
ROOMSCOUT_LLM_TOKEN_PARAMETER=max_tokens
ROOMSCOUT_LLM_JSON_MODE=true
ROOMSCOUT_LLM_MAX_CANDIDATES=8
